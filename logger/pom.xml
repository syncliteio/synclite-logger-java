<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.synclite</groupId>
	<artifactId>synclite</artifactId>
	<version>${revision}</version>
	<name>synclite</name>
	<description>SyncLite sql logger for Java applications</description>
	<properties>
		<revision>1.0.0</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
        <maven.javadoc.tags>
            JDBC, Embedded DB, RDBMS, SQLite, DuckDB, Apache Derby, H2, HyperSQL
        </maven.javadoc.tags>
		<!--
			Root of the sibling Rust cargo workspace. The antrun step below
			copies any synclite_jni native libs it finds under this path
			into the jar's META-INF/native/<classifier>/ tree. The copy is
			best-effort (failonerror=false): a fresh checkout with no
			Rust toolchain still builds a logger-only jar, and consumers
			that don't need the in-process consolidator never have to
			install Rust.
		-->
		<synclite.rust.target.dir>${project.basedir}/../../synclite-logger-rust/target</synclite.rust.target.dir>
		<!--
			Skip the cargo build of the JNI native. Set to true (or pass
			-DskipRustRuntime=true) to produce a logger-only jar on a
			host without a Rust toolchain. Default false: try to build,
			tolerate failure (the antrun copy step is also best-effort).
		-->
		<skipRustRuntime>false</skipRustRuntime>
		<!--
			Skip the cross-compiled Linux JNI natives (cargo-zigbuild for
			x86_64 + aarch64). Default false: attempt them so the jar ships
			Linux .so bindings alongside the host native. Best-effort — a host
			without cargo-zigbuild/zig degrades to a host-only jar. Pass
			-DskipRustCrossCompile=true to skip explicitly (also faster).
		-->
		<skipRustCrossCompile>false</skipRustCrossCompile>
		<!--
			Default: don't exclude any tests (placeholder pattern matches no class).
			The `skip-rust-runtime-tests` profile below overrides this to skip
			the *TestWithConsolidator suites when -DskipRustRuntime=true is passed.
		-->
		<surefire.consolidator.exclude>**/__never_matches_anything__</surefire.consolidator.exclude>
		<!--
			Third-party license download/report. This hits the network and is
			slow, so it is SKIPPED by default (skipDownloadLicenses=true) and
			only runs for release builds invoked with -DskipDownloadLicenses=false
			(e.g. mvn -DskipDownloadLicenses=false package).
		-->
		<skipDownloadLicenses>true</skipDownloadLicenses>
	</properties>

	<build>
		<resources>
			<!-- Filter only synclite-native.properties so ${revision} gets substituted; everything else copied as-is. -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>META-INF/synclite-native.properties</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>META-INF/synclite-native.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>11</release>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.1.2</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<!-- configure the plugin here -->
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				Build the Rust JNI native (libsynclite_<rev>_jni.*) when a Rust
				toolchain is on PATH. Uses antrun's <exec> rather than
				exec-maven-plugin because antrun supports
				`failifexecutionfails="false"`, so a host *without* cargo
				degrades to a warning + a logger-only jar instead of a hard
				build break. `failonerror="false"` likewise tolerates a
				non-zero cargo exit. To skip the cargo invocation entirely
				(saves the warning + tool lookup), pass
				-DskipRustRuntime=true or -DskipNonJavaLoggers=true.
				The antrun copy step further down picks up whatever cargo
				actually produced (which may be nothing).
			-->

			<!--
				Best-effort bundling of the Rust JNI native libraries built
				by `cargo build -p synclite-bindings-java` in the sibling
				synclite-logger-rust workspace. The naming convention matches
				the release zip's lib/native/ folder: libsynclite_<rev>_jni.<ext>
				(plus _linux_x86_64 / _linux_aarch64 suffixes for cross-compiled
				Linux variants). When this module is built standalone (no root
				pom rename step) the antrun also accepts cargo's raw output
				names (synclite_jni.dll, libsynclite_jni.so, libsynclite_jni.dylib)
				and renames them to the canonical jar-internal name via mapper.

				Every copy is failonerror="false" so a checkout without a Rust
				toolchain still produces a clean logger-only synclite jar.
				When a native lib IS present it ends up at
				META-INF/native/<classifier>/libsynclite_<rev>_jni.<ext> inside
				this jar, which is the same path the consolidator-side
				NativeLoader searches.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<!--
							Detect the Rust cross toolchain up front (phase=initialize)
							and export effective <skip> flags so the cargo steps below
							are SKIPPED (not merely tolerated) when cargo/zig/cargo-zigbuild
							are absent. antrun's failifexecutionfails=false stops a missing
							tool from FAILING the build, but antrun still logs the
							IOException at [ERROR]; probing through the OS shell
							(where/command -v) returns a clean exit code instead, so a
							Java-only checkout builds with NO scary error lines.
						-->
						<id>detect-jni-toolchain</id>
						<phase>initialize</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<exportAntProperties>true</exportAntProperties>
							<target>
								<macrodef name="probe">
									<attribute name="prop"/>
									<attribute name="wincmd"/>
									<attribute name="nixcmd"/>
									<sequential>
										<exec osfamily="windows" executable="cmd" failifexecutionfails="false" resultproperty="@{prop}.rc">
											<arg value="/c"/><arg value="@{wincmd}"/>
										</exec>
										<exec osfamily="unix" executable="sh" failifexecutionfails="false" resultproperty="@{prop}.rc">
											<arg value="-c"/><arg value="@{nixcmd}"/>
										</exec>
										<condition property="@{prop}" value="true"><equals arg1="${@{prop}.rc}" arg2="0"/></condition>
										<property name="@{prop}" value="false"/>
									</sequential>
								</macrodef>
								<probe prop="cargoPresent"    wincmd="where cargo >NUL 2>NUL"          nixcmd="command -v cargo >/dev/null 2>&amp;1"/>
								<!--
								  zig may be a standalone binary on PATH OR the `ziglang` pip
								  package (cargo-zigbuild transparently runs `python -m ziglang`
								  when no `zig` binary exists), so accept EITHER form.
								-->
								<probe prop="zigPresent"      wincmd="where zig >NUL 2>NUL || python -m ziglang version >NUL 2>NUL || py -m ziglang version >NUL 2>NUL"            nixcmd="command -v zig >/dev/null 2>&amp;1 || python3 -m ziglang version >/dev/null 2>&amp;1 || python -m ziglang version >/dev/null 2>&amp;1"/>
								<probe prop="zigbuildPresent" wincmd="where cargo-zigbuild >NUL 2>NUL" nixcmd="command -v cargo-zigbuild >/dev/null 2>&amp;1"/>
								<!-- effectiveSkipJni = skipRustRuntime OR (cargo absent). -->
								<condition property="effectiveSkipJni" value="true"><or><istrue value="${skipRustRuntime}"/><isfalse value="${cargoPresent}"/></or></condition>
								<property name="effectiveSkipJni" value="false"/>
								<!-- effectiveSkipJniCross = skipRustCrossCompile OR NOT(cargo AND zig AND cargo-zigbuild). -->
								<condition property="effectiveSkipJniCross" value="true">
									<or>
										<istrue value="${skipRustCrossCompile}"/>
										<not><and><istrue value="${cargoPresent}"/><istrue value="${zigPresent}"/><istrue value="${zigbuildPresent}"/></and></not>
									</or>
								</condition>
								<property name="effectiveSkipJniCross" value="false"/>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>cargo-build-jni</id>
						<phase>generate-resources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<skip>${effectiveSkipJni}</skip>
							<target>
								<exec executable="cargo"
								      dir="${project.basedir}/../../synclite-logger-rust"
								      failonerror="false"
								      failifexecutionfails="false">
									<arg value="build"/>
									<arg value="--package=synclite-bindings-java"/>
									<arg value="--release"/>
								</exec>
							</target>
						</configuration>
					</execution>
					<execution>
						<!--
							Cross-compile the Linux JNI cdylibs (x86_64 + aarch64)
							via cargo-zigbuild so the jar's META-INF/native/linux-*
							slots are populated, not just windows-x64. Same crate as
							the host build (synclite-bindings-java -> libsynclite_jni.so
							under target/<triple>/release/). Best-effort: a host
							without cargo-zigbuild/zig (or the rustup targets) degrades
							to a host-only jar. Runs before copy-native-libs (declaration
							order within generate-resources) so the copy step finds them.
						-->
						<id>cargo-build-jni-cross</id>
						<phase>generate-resources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<skip>${effectiveSkipJniCross}</skip>
							<target>
								<exec executable="cargo"
								      dir="${project.basedir}/../../synclite-logger-rust"
								      failonerror="false"
								      failifexecutionfails="false">
									<env key="SYNCLITE_RUST_ARTIFACT_VERSION" value="${revision}"/>
									<arg value="zigbuild"/>
									<arg value="--package=synclite-bindings-java"/>
									<arg value="--release"/>
									<arg value="--target"/>
									<arg value="x86_64-unknown-linux-gnu"/>
								</exec>
								<exec executable="cargo"
								      dir="${project.basedir}/../../synclite-logger-rust"
								      failonerror="false"
								      failifexecutionfails="false">
									<env key="SYNCLITE_RUST_ARTIFACT_VERSION" value="${revision}"/>
									<arg value="zigbuild"/>
									<arg value="--package=synclite-bindings-java"/>
									<arg value="--release"/>
									<arg value="--target"/>
									<arg value="aarch64-unknown-linux-gnu"/>
								</exec>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>copy-native-libs</id>
						<phase>generate-resources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<mkdir dir="${project.build.outputDirectory}/META-INF/native/windows-x64"/>
								<mkdir dir="${project.build.outputDirectory}/META-INF/native/linux-x64"/>
								<mkdir dir="${project.build.outputDirectory}/META-INF/native/linux-arm64"/>
								<mkdir dir="${project.build.outputDirectory}/META-INF/native/macos-x64"/>
								<mkdir dir="${project.build.outputDirectory}/META-INF/native/macos-arm64"/>
								<!--
									libsynclite_<rev>_jni.<ext>: built by
									`cargo build -p synclite-bindings-java`, optionally renamed
									by the parent platform pom. Each <copy> flattens to the
									canonical jar-internal name so NativeLoader can resolve
									it without enumerating jar entries.
								-->
								<copy todir="${project.build.outputDirectory}/META-INF/native/windows-x64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="release/libsynclite_${revision}_jni.dll"/>
										<include name="release/synclite_jni.dll"/>
									</fileset>
									<mapper type="merge" to="libsynclite_${revision}_jni.dll"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/linux-x64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="release/libsynclite_${revision}_jni.so"/>
										<include name="release/libsynclite_${revision}_jni_linux_x86_64.so"/>
										<include name="x86_64-unknown-linux-gnu/release/libsynclite_jni.so"/>
										<include name="release/libsynclite_jni.so"/>
									</fileset>
									<mapper type="merge" to="libsynclite_${revision}_jni.so"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/linux-arm64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="release/libsynclite_${revision}_jni_linux_aarch64.so"/>
										<include name="aarch64-unknown-linux-gnu/release/libsynclite_jni.so"/>
									</fileset>
									<mapper type="merge" to="libsynclite_${revision}_jni.so"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/macos-x64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="x86_64-apple-darwin/release/libsynclite_jni.dylib"/>
									</fileset>
									<mapper type="merge" to="libsynclite_${revision}_jni.dylib"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/macos-arm64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="release/libsynclite_${revision}_jni.dylib"/>
										<include name="release/libsynclite_jni.dylib"/>
										<include name="aarch64-apple-darwin/release/libsynclite_jni.dylib"/>
									</fileset>
									<mapper type="merge" to="libsynclite_${revision}_jni.dylib"/>
								</copy>
								<!--
									duckdb: prebuilt shared lib downloaded by the duckdb-rs build
									script into target/duckdb-download/<triple>/<version>/. synclite_jni
									dynamically links against it, so we ship it alongside and the
									Java NativeLoader extracts + System.load()s it before synclite_jni.
								-->
								<copy todir="${project.build.outputDirectory}/META-INF/native/windows-x64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="duckdb-download/x86_64-pc-windows-msvc/*/duckdb.dll"/>
									</fileset>
									<mapper type="merge" to="duckdb.dll"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/linux-x64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="duckdb-download/x86_64-unknown-linux-gnu/*/libduckdb.so"/>
									</fileset>
									<mapper type="merge" to="libduckdb.so"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/linux-arm64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="duckdb-download/aarch64-unknown-linux-gnu/*/libduckdb.so"/>
									</fileset>
									<mapper type="merge" to="libduckdb.so"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/macos-x64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="duckdb-download/x86_64-apple-darwin/*/libduckdb.dylib"/>
									</fileset>
									<mapper type="merge" to="libduckdb.dylib"/>
								</copy>
								<copy todir="${project.build.outputDirectory}/META-INF/native/macos-arm64"
									  failonerror="false" quiet="true">
									<fileset dir="${synclite.rust.target.dir}" erroronmissingdir="false">
										<include name="duckdb-download/aarch64-apple-darwin/*/libduckdb.dylib"/>
									</fileset>
									<mapper type="merge" to="libduckdb.dylib"/>
								</copy>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>2.0.0</version>
				<executions>
					<execution>
						<id>generate-third-party-report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>download-licenses</goal>
							<goal>third-party-report</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<skipDownloadLicenses>${skipDownloadLicenses}</skipDownloadLicenses>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<appendAssemblyId>false</appendAssemblyId>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<!--
						Surefire's default include patterns only match *Test.java / *Tests.java /
						*TestCase.java / Test*.java. The consolidator-flavored suites are named
						*TestWithConsolidator.java, so they must be added explicitly or they are
						silently skipped during normal discovery.

						When the Rust JNI runtime is not built (-DskipRustRuntime=true) the
						*TestWithConsolidator suites cannot run because they bind to the
						in-process native consolidator; the skip-rust-runtime-tests profile
						overrides surefire.consolidator.exclude to exclude them in that case.
					-->
					<includes>
						<include>**/Test*.java</include>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
						<include>**/*TestWithConsolidator.java</include>
					</includes>
					<excludes combine.children="append">
						<exclude>${surefire.consolidator.exclude}</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- JUnit 5 for tests -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.2</version>
			<scope>test</scope>
		</dependency>
		<!--
			LauncherSessionListener (TestJobRootCleaner) lives here and is wired
			via META-INF/services. Surefire pulls in junit-platform-launcher
			transitively, but declare it explicitly so the ServiceLoader API on
			the test classpath at compile time too.
		-->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<version>1.10.2</version>
			<scope>test</scope>
		</dependency>

		<!-- https://mvnrepository.com/artifact/org.xerial/sqlite-jdbc -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.53.0.0</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/com.jcraft/jsch -->
		<dependency>
			<groupId>com.github.mwiede</groupId>
			<artifactId>jsch</artifactId>
			<version>0.2.22</version>
		</dependency>

		<dependency>
			<groupId>ch.qos.reload4j</groupId>
			<artifactId>reload4j</artifactId>
			<version>1.2.25</version>
		</dependency>
		
		<dependency>
    		<groupId>org.slf4j</groupId>
		    <artifactId>slf4j-api</artifactId>
    		<version>1.7.36</version>
		</dependency>

		<!--
		    SLF4J binding: routes slf4j.Logger calls (used by the Rust JNI
		    bridge's tracing-log appender and by several transitive deps)
		    to reload4j, which we already depend on. Without this binding
		    slf4j falls back to NOPLogger and silently swallows all
		    consolidator-side warnings/errors. Mandatory for diagnosability.
		-->
		<dependency>
		    <groupId>org.slf4j</groupId>
		    <artifactId>slf4j-reload4j</artifactId>
		    <version>1.7.36</version>
		</dependency>

		<dependency>
		    <groupId>io.minio</groupId>
		    <artifactId>minio</artifactId>
		    <version>8.6.0</version>
		</dependency>

		<!-- OkHttp JVM artifact required by minio 8.6.0 (Kotlin Multiplatform) -->
		<dependency>
		    <groupId>com.squareup.okhttp3</groupId>
		    <artifactId>okhttp-jvm</artifactId>
		    <version>5.1.0</version>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/org.apache.kafka/kafka-clients -->
		<dependency>
		    <groupId>org.apache.kafka</groupId>
		    <artifactId>kafka-clients</artifactId>
		    <version>3.9.0</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/redis.clients/jedis -->
		<dependency>
		    <groupId>redis.clients</groupId>
		    <artifactId>jedis</artifactId>
		    <version>4.4.8</version>
		</dependency>

		<!-- In-process fake Redis server for JedisTest – no Docker or Redis install needed -->
		<dependency>
		    <groupId>com.github.fppt</groupId>
		    <artifactId>jedis-mock</artifactId>
		    <version>1.1.2</version>
		    <scope>test</scope>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/com.amazonaws/aws-java-sdk-s3 -->
		<dependency>
		    <groupId>com.amazonaws</groupId>
		    <artifactId>aws-java-sdk-s3</artifactId>
		    <version>1.12.403</version>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/org.duckdb/duckdb_jdbc -->
		<!--
			DuckDB's JDBC driver bundles native libraries (~50+ MB) which
			would inflate the synclite jar-with-dependencies. We mark it
			'provided' so it stays on the compile/test classpath but is
			excluded from the assembled fat jar and is NOT propagated as
			a transitive dependency. Applications that use a DuckDB
			device must add this dependency themselves:

				<dependency>
				    <groupId>org.duckdb</groupId>
				    <artifactId>duckdb_jdbc</artifactId>
				    <version>1.5.2.0</version>
				</dependency>
		-->
		<dependency>
		    <groupId>org.duckdb</groupId>
		    <artifactId>duckdb_jdbc</artifactId>
		    <version>1.5.2.0</version>
		    <scope>provided</scope>
		</dependency>		

		<!-- https://mvnrepository.com/artifact/org.apache.derby/derby -->
		<!-- Derby 10.14.x is the last release with EmbeddedDriver and Java 8/11 support -->
		<dependency>
		    <groupId>org.apache.derby</groupId>
		    <artifactId>derby</artifactId>
		    <version>10.14.2.0</version>
		</dependency>
		
		<dependency>
		    <groupId>com.h2database</groupId>
		    <artifactId>h2</artifactId>
		    <version>2.3.230</version>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/org.hsqldb/hsqldb -->
		<dependency>
		    <groupId>org.hsqldb</groupId>
		    <artifactId>hsqldb</artifactId>
		    <version>2.7.3</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/org.postgresql/postgresql -->
		<!-- ~1.1 MB; bundled so sample apps and the in-process consolidator
		     can talk to a POSTGRES destination without an extra jar on the
		     classpath. -->
		<dependency>
		    <groupId>org.postgresql</groupId>
		    <artifactId>postgresql</artifactId>
		    <version>42.7.7</version>
		</dependency>

	</dependencies>

	<profiles>
		<!--
			Activated automatically by `-DskipNonJavaLoggers=true` (the same
			umbrella flag honored by the parent platform pom). This child pom
			has no <parent>, so the platform pom's profile properties don't
			flow down here — we must mirror the skip locally. Forces
			`skipRustRuntime=true` so the `cargo-build-jni` exec is skipped
			and the `skip-rust-runtime-tests` profile below also activates,
			excluding the *TestWithConsolidator suites.
		-->
		<profile>
			<id>skip-nonjava-loggers</id>
			<activation>
				<property>
					<name>skipNonJavaLoggers</name>
				</property>
			</activation>
			<properties>
				<skipRustRuntime>true</skipRustRuntime>
			</properties>
		</profile>
		<!--
			Activated automatically by `-DskipRustRuntime=true`. Sets the
			surefire exclude pattern so the *TestWithConsolidator suites
			(which need the Rust JNI runtime) are skipped, leaving only
			the logger-only (javalogger) test set running.
		-->
		<profile>
			<id>skip-rust-runtime-tests</id>
			<activation>
				<property>
					<name>skipRustRuntime</name>
				</property>
			</activation>
			<properties>
				<surefire.consolidator.exclude>**/*TestWithConsolidator.java</surefire.consolidator.exclude>
			</properties>
		</profile>
	</profiles>
</project>
